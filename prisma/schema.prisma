generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  trades               Trade[]
  setupTypes           SetupType[]
  confirmationTypes    ConfirmationType[]
  setupDescriptions    UserSetupDescription[]
  researchEntries      ResearchEntry[]
  passwordResetTokens  PasswordResetToken[]
  propAccount          PropAccount?
  killSwitchPause      KillSwitchPause?
  dailyRecaps          DailyRecap[]
}

model DailyRecap {
  id                 String   @id @default(cuid())
  userId             String
  date               DateTime
  keptLossLimit      Boolean  @default(false)
  setupsOnly         Boolean  @default(false)
  noStopMoving       Boolean  @default(false)
  madePlan           Boolean  @default(false)
  followedPlan       Boolean  @default(false)
  preMarketJournal   Boolean  @default(false)
  keptMaxTrades      Boolean  @default(false)
  keptRiskRules      Boolean  @default(false)
  disciplineScore    Int
  lessonOfDay        String   @default("")
  sessionEfficiency  Float?
  sessionStatus      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Trade {
  id               String    @id @default(cuid())
  userId           String
  symbol           String
  direction        String    // long | short
  instrumentType   String    // options | futures | stocks
  risk             Float     // amount at risk
  rr               Float     // risk:reward ratio (e.g. 2 = 1:2)
  outcome          String    // win = TP hit, loss = SL hit
  pnl              Float     // calculated: win ? risk*rr : -risk
  fees             Float     @default(0)
  date             DateTime  // trade date
  marketCondition  String?   // mean_reversion | trend | range | etc
  notes            String?
  confirmationNotes String?
  energyLevel      Int?      // 1–5 trader energy
  sleepHours       Float?
  stressLevel      String?   // low | medium | high
  stateMoodTag     String?   // FOMO | Tilt | Calm | custom
  marketVolatility String?   // low | medium | high
  sessionType      String?   // trend | range
  price5mAfter     Float?
  price15mAfter    Float?
  price60mAfter    Float?
  entryPrice       Float?
  exitPrice        Float?
  initialTp        Float?
  initialSl        Float?
  exitType         String    @default("system") // system | manual
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags              TradeTag[]
  images            TradeImage[]
  setups            TradeSetup[]
  confirmations     TradeConfirmation[]
}

model TradeTag {
  id        String   @id @default(cuid())
  tradeId   String
  name      String

  trade     Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@unique([tradeId, name])
}

model TradeImage {
  id        String   @id @default(cuid())
  tradeId   String
  url       String   // path or base64 for now
  caption   String?

  trade     Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)
}

model SetupType {
  id          String   @id @default(cuid())
  name        String
  description String?  // for user-defined types
  userId      String?  // null = system, else user-defined

  user              User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades            TradeSetup[]
  userDescriptions  UserSetupDescription[]
}

model UserSetupDescription {
  id           String     @id @default(cuid())
  userId       String
  setupTypeId  String
  description  String     // user's personal notes for this setup (works for system + custom)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  setupType SetupType @relation(fields: [setupTypeId], references: [id], onDelete: Cascade)

  @@unique([userId, setupTypeId])
}

model ResearchEntry {
  id        String   @id @default(cuid())
  userId    String
  title     String
  content   String   // markdown / rich text
  type      String   // note | setup | strategy
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  images ResearchImage[]
}

model ResearchImage {
  id           String   @id @default(cuid())
  researchId   String
  url          String
  caption      String?

  researchEntry ResearchEntry @relation(fields: [researchId], references: [id], onDelete: Cascade)
}

model ConfirmationType {
  id     String   @id @default(cuid())
  name   String
  userId String?  // null = system

  user   User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades TradeConfirmation[]
}

model TradeSetup {
  tradeId     String
  setupTypeId String
  notes       String?

  trade       Trade     @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  setupType   SetupType @relation(fields: [setupTypeId], references: [id], onDelete: Cascade)

  @@unique([tradeId, setupTypeId])
}

model TradeConfirmation {
  tradeId           String
  confirmationTypeId String
  notes             String?

  trade             Trade           @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  confirmationType  ConfirmationType @relation(fields: [confirmationTypeId], references: [id], onDelete: Cascade)

  @@unique([tradeId, confirmationTypeId])
}

model PropAccount {
  id                         String   @id @default(cuid())
  userId                     String   @unique
  startingBalance            Float
  maxDailyLossPercent        Float    @default(5)
  maxDailyLossUsd            Float?   // optional cap in account currency; if null, only % applies
  maxTrailingDrawdownPercent Float    @default(10)
  peakBalance                Float    // high-water equity; updated when metrics are computed
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model KillSwitchPause {
  userId    String   @id
  until     DateTime
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
